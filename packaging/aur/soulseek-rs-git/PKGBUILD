# Maintainer: Michel de Graaf <michel at re-invention dot nl>
pkgname=soulseek-rs-git
pkgver=19.0.0.r19.gdeb846b
pkgrel=1
pkgdesc='Soulseek client for the terminal, with a scriptable CLI and daemon (development branch)'
arch=('x86_64' 'aarch64')
url='https://re-invention.nl/soulseek-rs/'
license=('MIT')
depends=('gcc-libs' 'glibc')
makedepends=('cargo' 'git')
optdepends=('gnome-keyring: keep the account password in a Secret Service keyring')
provides=("soulseek-rs=$pkgver")
conflicts=('soulseek-rs')
options=('!debug')
source=("$pkgname::git+https://github.com/michel/soulseek-rs.git#branch=develop")
sha256sums=('SKIP')

pkgver() {
  cd "$pkgname"
  git describe --long --tags --abbrev=7 --match 'v*' | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  export SOULSEEK_RS_VERSION=$pkgver
  cargo build --frozen --release --package soulseek-rs
}

package() {
  cd "$pkgname"
  local bin=target/release/soulseek-rs
  install -Dm755 "$bin" -t "$pkgdir/usr/bin/"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname/"
  "$bin" completions print bash > soulseek-rs.bash
  "$bin" completions print zsh > _soulseek-rs
  "$bin" completions print fish > soulseek-rs.fish
  "$bin" man > soulseek-rs.1
  install -Dm644 soulseek-rs.bash "$pkgdir/usr/share/bash-completion/completions/soulseek-rs"
  install -Dm644 _soulseek-rs -t "$pkgdir/usr/share/zsh/site-functions/"
  install -Dm644 soulseek-rs.fish -t "$pkgdir/usr/share/fish/vendor_completions.d/"
  install -Dm644 soulseek-rs.1 -t "$pkgdir/usr/share/man/man1/"
}
